{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banmeaw-trainee",
  "compatibility_date": "2026-10-03",
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-lucky-poetry-azjvlwv7.neonauth.c-3.ap-southeast-1.aws.neon.tech/banmeaw_trainee/auth"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "src/worker.mjs",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ]
}
